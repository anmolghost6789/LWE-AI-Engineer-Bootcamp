# ==============================================================================
# Environment configuration for learnwithexpert*
# ==============================================================================
# Nothing here is needed to build the site or serve the marketing page. These
# values are read only by the optional Resend notification in api/contact.ts.
#
# IMPORTANT
# - These are server-side secrets. Never prefix them with VITE_: Vite inlines
#   every VITE_* value into the public client bundle.
# - Never commit a filled .env. Locally, copy this file to .env (git-ignored).
# - Vercel: Project -> Settings -> Environment Variables (Production / Preview /
#   Development), then redeploy. Existing deployments keep the old values.
# - The Cloudflare Worker (src/worker/index.ts) does not read these yet and has
#   no /api/contact route; add the route and Worker secrets before relying on it.

# ------------------------------------------------------------------------------
# Resend transactional email (https://resend.com) - server-side only
# ------------------------------------------------------------------------------
# Create a key at https://resend.com/api-keys. Without it, the contact form still
# accepts the submission but no notification email is sent.

RESEND_API_KEY=your_resend_api_key_here

# Inbox that receives "Work With Us" inquiries. Optional.
TEAM_NOTIFICATION_EMAIL=hr@rhevix.com

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Continue with Google)
# ------------------------------------------------------------------------------
# 1. Create an OAuth 2.0 Web Client in Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
# 2. Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://localhost:5174
#    - https://<your-vercel-deployment>.vercel.app
# 3. Authorized redirect URIs:
#    - http://localhost:5173
#    - http://localhost:5174
#    - https://<your-vercel-deployment>.vercel.app
# 4. Set the Client ID:
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Persistent Database Storage (Optional)
# ------------------------------------------------------------------------------
# If you want permanent cloud persistence across serverless cold starts:
#
# Option A: Upstash Redis / Vercel KV (Fastest, zero setup, REST-based):
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
#
# Option B: PostgreSQL / Supabase / Neon:
# DATABASE_URL=postgresql://user:password@host:port/dbname

